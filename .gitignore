# Secrets and local environment.
.env
.env.*
!.env.example

# Dependencies, build output, caches, and logs.
node_modules/
dist/
build/
coverage/
.cache/
.tmp/
tmp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS/editor noise.
.DS_Store
Thumbs.db

# Local/private agent notes.
*.local.md

# Local input manifests often contain private absolute paths and video IDs.
inputs/*.jsonl
!inputs/*.example.jsonl
!inputs/.gitkeep

# Local raw media, models, and inbox files. Keep only explicit fixtures.
inbox/*
!inbox/.gitkeep
models/
*.mov
*.mp4
*.m4v
*.wav
*.mp3
*.m4a
!fixtures/sample.mp4

# Private analysis artifacts and OAuth tokens.
.system/*
!.system/.gitkeep

outputs/*
!outputs/.gitkeep
